{
  "name": "@slashome/lumen",
  "version": "0.1.0",
  "description": "The slashome design system: tokens, CSS classes and custom elements for React, Vue, Svelte and plain HTML.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slashome/lumen.git"
  },
  "homepage": "https://slashome.github.io/lumen/",
  "files": [
    "dist",
    "custom-elements.json",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/icon.js",
    "./dist/dialog.js",
    "./dist/sheet.js",
    "./dist/confirm-dialog.js",
    "./dist/tooltip.js",
    "./dist/hover-card.js",
    "./dist/select.js",
    "./dist/multi-select.js",
    "./dist/segmented.js",
    "./dist/tabs.js",
    "./dist/toaster.js",
    "./dist/markdown.js",
    "./dist/highlight.js",
    "./dist/drag-area.js",
    "./dist/file-drop.js",
    "./dist/components/select/option.js",
    "./dist/components/drag-area/draggable.js",
    "./dist/components/drag-area/drop-zone.js",
    "./dist/css/*.css",
    "./src/index.ts",
    "./src/components/*/*.ts"
  ],
  "bin": {
    "lumen-icons": "./scripts/icons.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/types/components/icon/icon.d.ts",
      "default": "./dist/icon.js"
    },
    "./dialog": {
      "types": "./dist/types/components/dialog/dialog.d.ts",
      "default": "./dist/dialog.js"
    },
    "./sheet": {
      "types": "./dist/types/components/sheet/sheet.d.ts",
      "default": "./dist/sheet.js"
    },
    "./confirm-dialog": {
      "types": "./dist/types/components/confirm-dialog/confirm-dialog.d.ts",
      "default": "./dist/confirm-dialog.js"
    },
    "./tooltip": {
      "types": "./dist/types/components/tooltip/tooltip.d.ts",
      "default": "./dist/tooltip.js"
    },
    "./hover-card": {
      "types": "./dist/types/components/hover-card/hover-card.d.ts",
      "default": "./dist/hover-card.js"
    },
    "./select": {
      "types": "./dist/types/components/select/select.d.ts",
      "default": "./dist/select.js"
    },
    "./multi-select": {
      "types": "./dist/types/components/multi-select/multi-select.d.ts",
      "default": "./dist/multi-select.js"
    },
    "./segmented": {
      "types": "./dist/types/components/segmented/segmented.d.ts",
      "default": "./dist/segmented.js"
    },
    "./tabs": {
      "types": "./dist/types/components/tabs/tabs.d.ts",
      "default": "./dist/tabs.js"
    },
    "./toaster": {
      "types": "./dist/types/components/toaster/toaster.d.ts",
      "default": "./dist/toaster.js"
    },
    "./markdown": {
      "types": "./dist/types/components/markdown/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./highlight": {
      "types": "./dist/types/components/highlight/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./drag-area": {
      "types": "./dist/types/components/drag-area/drag-area.d.ts",
      "default": "./dist/drag-area.js"
    },
    "./file-drop": {
      "types": "./dist/types/components/file-drop/file-drop.d.ts",
      "default": "./dist/file-drop.js"
    },
    "./lib": {
      "types": "./dist/types/lib/index.d.ts",
      "default": "./dist/lib.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "default": "./dist/vue.js"
    },
    "./lumen.css": "./dist/css/lumen.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./css/*": "./dist/css/*",
    "./custom-elements.json": "./custom-elements.json",
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "customElements": "custom-elements.json",
  "scripts": {
    "generate": "node scripts/tokens.js && node scripts/icons.js icons/lumen.json src/icons/generated.ts && cem analyze --quiet && node scripts/adapters.js",
    "build": "pnpm generate && vite build && tsc -p tsconfig.build.json && node scripts/copy-css.js",
    "typecheck": "pnpm generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm generate && vitest run --project unit",
    "test:browser": "pnpm generate && vitest run --project storybook",
    "storybook": "pnpm generate && storybook dev -p 6006",
    "build-storybook": "pnpm generate && storybook build"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@floating-ui/dom": "1.8.0",
    "@iconify/utils": "3.1.7",
    "dompurify": "3.4.17",
    "lit": "3.3.3",
    "marked": "18.1.2"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.8",
    "react": "^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "1.2.149",
    "@lit/react": "1.0.8",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/web-components-vite": "10.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "style-dictionary": "5.7.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  },
  "packageManager": "pnpm@12.16.1"
}
